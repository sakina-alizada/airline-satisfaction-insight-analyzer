# .gitignore — Airline Satisfaction Insight Analyzer

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.pyo

# ── Virtual environments ─────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# ── Environment variables & secrets ──────────────────────────────────────
.env
.env.local
.env.*.local
*.env
secrets.json
credentials.json

# ── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
notebooks/.ipynb_checkpoints/

# ── Data files (large CSVs — add your own if needed) ─────────────────────
# Uncomment to exclude raw data from the repo
# data/*.csv
# data/*.parquet
# data/*.xlsx

# ── Model files ───────────────────────────────────────────────────────────
outputs/models/*.joblib
outputs/models/*.pkl

# ── Generated outputs (optional — keep if you want to commit results) ────
# outputs/figures/
# outputs/reports/

# ── OS / Editor ───────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Testing ───────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.coveragerc

# ── Distribution / packaging ──────────────────────────────────────────────
MANIFEST
*.manifest
*.spec

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
logs/
